# ==============================================================================
# warp-unlock v2.0（官方客户端 MASQUE 架构）环境变量
# ==============================================================================

# WARP+ License（可选）：填入 26 位 License（格式 xxxxxxxx-xxxxxxxx-xxxxxxxx）
# 绑定后账户升级为 WARP+（流量优先级更高）；留空则使用免费账户
# 更换 License：修改此值并重启容器即可重新绑定
WARP_LICENSE=

# 代理认证（可选）：两者同时填写才生效，用于 HTTP Basic 与 SOCKS5 user/pass 认证
# 适用场景：将端口映射到 0.0.0.0 公网暴露时，防止被扫描白嫖；仅本机 127.0.0.1 使用可留空
PROXY_USER=
PROXY_PASS=

# 流媒体解锁巡检（可选）：定期检测，未通过自动重连换 IP
# 检测项：n=Netflix，d=Disney+，c=ChatGPT；留空 = 不做任何检测（仅保活）
UNLOCK_STREAMS=ndc
# 巡检间隔（秒），默认 300（5 分钟）
UNLOCK_INTERVAL=300
# 设为 0 可关闭解锁巡检（仅保留隧道看门狗）
WARP_AUTO_UNLOCK=1

# 期望出口地区（可选）：两位国家/地区代码（us/sg/jp/hk/tw/gb...）
# 非空时解锁巡检会校验 trace 的 loc= 是否匹配，不匹配视为未通过并触发轮换
# 注意：官方客户端无法像 v1.x 那样直接指定地区，此值为"验证目标"而非强制切换
WARP_REGION=

# 自定义入口 Endpoint（高级）：格式 IP:PORT，钉住特定 Cloudflare 入口可影响落地地区
# 通常留空即可；配合 WARP_REGION 验证使用
WARP_ENDPOINT=

# 看门狗巡检间隔（秒）：定期验证隧道连通性，失联自动重连；默认 60
WARP_WATCHDOG_INTERVAL=60

# warp-svc 日志级别：error / warn / info / debug / trace（默认 info，屏蔽 DEBUG 刷屏）
WARP_LOG_LEVEL=info
# warp-svc 日志落盘文件：对应宿主机 ./logs/warp.log，超过 10MB 自动轮转保留最近 2000 行
# 留空 = 仅输出到 docker logs 不落盘
WARP_LOG_FILE=/logs/warp.log

# GOST 版本（构建参数），建议保持默认
GOST_VERSION=2.11.5

# UPX 压缩 warp-svc（构建参数）：1 = 开启（默认，镜像 ~139MB）
# 若守护进程出现异常，改回 0 重新构建即可回退（~190MB）
UPX_WARP_SVC=1
