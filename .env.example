# WARP 目标地区，两位国家/地区代码，例如 us、sg、jp、hk
WARP_REGION=us

# n=Netflix，d=Disney+，c=ChatGPT；ndc 表示全部检测
UNLOCK_STREAMS=nd

# 解锁检测使用哪个地址族：4 或 6
# WGCF 隧道本身仍然启用 IPv4 + IPv6 双栈
WARP_FAMILY=6

# WARP+ License（可选）：填入 26 位 License（格式 xxxxxxxx-xxxxxxxx-xxxxxxxx）
# 绑定后账户升级为 WARP+（流量优先级更高）；留空则使用免费账户
# 更换 License：修改此值并重启容器即可自动重新绑定
WARP_LICENSE=

# 首次启动时自动安装 unlock.sh 的 5 分钟定时任务：1=自动，0=手动
WARP_AUTO_SETUP=1

# 构建版本；WGCF/GOST 版本可按需调整，但建议先保持默认值
WGCF_VERSION=2.2.32
GOST_VERSION=2.11.5

# 上游 unlock.sh 分支；Dockerfile 会校验 VERSION 必须为 1.22
UNLOCK_REF=main
