# ==============================================================================
# warp-unlock v2.0（官方客户端 MASQUE 架构）环境变量示例
#
# 本文件给出的是「低内存 / 精简日志 / 关闭自动解锁」的推荐生产配置。
# 用法：cp .env.example .env && 按需修改，然后 docker compose up -d --build
#
# 说明：不填任何变量也能跑（使用 docker-compose.yml 里的内置默认值：
#       MASQUE 协议、error 日志级别、自动解锁开启）。
#       下列取值若与默认值不同，注释里会标注「compose 默认」。
# ==============================================================================

# ------------------------------------------------------------------------------
# 一、省内存：隧道协议
# ------------------------------------------------------------------------------
# MASQUE（compose 默认）＝ QUIC/HTTP3 协议栈，warp-svc 稳态 ~150MB；
# WireGuard ＝ 老协议栈，无 QUIC/quiche，内存显著下降（小内存 VPS 推荐）。
# 代价：Cloudflare 重心在 MASQUE，两协议的出口特征/解锁表现可能有差异。
# 修改后需 docker compose up -d 重建容器才生效。
WARP_PROTOCOL=WireGuard

# ------------------------------------------------------------------------------
# 二、日志：3MB 分卷 + 保留 3 天
# ------------------------------------------------------------------------------
# 落盘位置：/logs/warp-YYYY-MM-DD.log（对应宿主机 ./logs/）
# 同日超限分卷：warp-2026-11-06.log（最新）→ warp-2026-11-06-01.log（上一卷）→ -02 …
# warp.log 是指向最新文件的软链；留空 = 不落盘（仅容器日志）
WARP_LOG_FILE=/logs/warp.log
# 单文件大小上限（MB）：默认 10；0 = 不限制。
# 分卷失败（只读挂载等）时退化为原地截断，仅保留最后 2000 行
WARP_LOG_MAX_SIZE_MB=3
# 日志保留天数：默认 3（今天 + 前 2 天），跨天清理更早的日期文件（含卷文件）
WARP_LOG_KEEP_DAYS=3
# 是否同步输出到容器日志（docker logs）：1 = 落盘 + 容器日志双路；
# 0 = 仅落盘，docker logs 只剩 entrypoint 生命周期日志（注册/重连/巡检）
WARP_LOG_STDOUT=1

# ------------------------------------------------------------------------------
# 三、日志等级 warn + 常规噪音过滤
# ------------------------------------------------------------------------------
# error（compose 默认）= 基本静默 / warn = 保留告警 / info、debug、trace = 排障用（量大）
# warn 档已内置容器环境白名单：fwmark 重装、IPC 断管、UDP 端口回退、SMBios 读取失败、
# 无 ZT 注册的遥测丢弃、网络事件转储、quiche idle timeout 等
WARP_LOG_LEVEL=warn
# 追加噪音拦截关键字（ERE 正则，| 分隔），叠加在内置白名单之上；可留空
# 注意：不要加引号，引号会被当作正则字符；确需字面量 | 时写 \|
LOG_NOISE_KEYWORDS=quiche: .*idle timeout|Broken pipe|Address already in use|addrinuse|Connection reset by peer|reconnect backoff|DNS request failed|No route to host|NetworkChanges|NewNeighbour|power_state|actor_emergency_disconnect

# ------------------------------------------------------------------------------
# 四、流媒体解锁：关闭自动巡检，保留手动查看
# ------------------------------------------------------------------------------
# 0 = 不自动检测、不自动换 IP（本文件的推荐值）；
# 1（compose 默认）= 按 UNLOCK_INTERVAL 定期检测，未通过自动重连刷 IP
WARP_AUTO_UNLOCK=0
# 检测项：n=Netflix，d=Disney+，c=ChatGPT；留空 = 不做任何检测
# 关闭自动巡检后，此值仅决定「手动检测」时跑哪几项
UNLOCK_STREAMS=ndc
# 自动巡检间隔（秒），仅 WARP_AUTO_UNLOCK=1 时生效
UNLOCK_INTERVAL=300
# 自动巡检未通过时是否轮换出口 IP：1 = 断开重连刷 IP（最多 3 次）/ 0 = 仅记录日志
# 已固定到优质 IP、不希望被换掉时设为 0
WARP_UNLOCK_ROTATE=1

# 手动查看解锁状态（不需要开启自动巡检）：
#   docker compose exec warp-unlock /app/unlock-check.sh     # 逐项检测结果
#   docker compose exec warp-unlock /app/check-status.sh     # 全量诊断（含实时解锁）
#   tail -20 logs/unlock.log                                 # 历史检测记录

# ------------------------------------------------------------------------------
# 五、账户、认证与出口
# ------------------------------------------------------------------------------
# WARP+ License（可选）：26 位，格式 xxxxxxxx-xxxxxxxx-xxxxxxxx
# 绑定后账户升级为 WARP+（流量优先级更高）；留空则使用免费账户
# 更换 License：修改此值并重启容器即可重新绑定
WARP_LICENSE=

# 代理认证（可选）：两者同时填写才生效（HTTP Basic + SOCKS5 user/pass）
# 适用场景：端口映射到 0.0.0.0 公网暴露时防扫描白嫖；仅本机 127.0.0.1 使用可留空
PROXY_USER=
PROXY_PASS=

# 期望出口地区（可选）：两位国家/地区代码（us/sg/jp/hk/tw/gb...）
# 非空时解锁巡检会校验 trace 的 loc= 是否匹配，不匹配视为未通过并触发轮换
# 注意：官方客户端无法像 v1.x 那样直接指定地区，此值为「验证目标」而非强制切换；
#       关闭自动巡检（WARP_AUTO_UNLOCK=0）时此值无作用
WARP_REGION=

# 自定义入口 Endpoint（高级）：格式 IP:PORT，钉住特定 Cloudflare 入口可影响落地地区
# 通常留空即可；配合 WARP_REGION 验证使用
WARP_ENDPOINT=

# 隧道看门狗巡检间隔（秒）：定期验证连通性，失联自动重连；默认 60
WARP_WATCHDOG_INTERVAL=60

# ------------------------------------------------------------------------------
# 六、构建参数（改动后需 docker compose up -d --build）
# ------------------------------------------------------------------------------
# UPX 压缩 warp-svc：1 = 开启（默认，镜像 ~139MB）；守护进程异常时改 0 回退（~190MB）
UPX_WARP_SVC=1

# GOST 版本，建议保持默认
GOST_VERSION=2.11.5
