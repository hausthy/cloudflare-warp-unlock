#!/usr/bin/env bash
# ==============================================================================
# wg-quick 兼容性适配包装器
# 专为容器内 wireguard-go 设计：
# 1. 拦截 up/down 操作并转交由 wireguard-manager.sh 统一管理用户态进程、路由及 DNS
# 2. 保留 strip 等辅助命令正常执行，确保上游 unlock.sh 完全兼容
# ==============================================================================
set -Eeuo pipefail

ACTION="${1:-}"
INTERFACE="${2:-wgcf}"

# 去除可能携带的路径或后缀（例如 /etc/wireguard/wgcf.conf -> wgcf）
INTERFACE="$(basename "$INTERFACE" .conf)"

case "$ACTION" in
  up)
    exec /app/wireguard-manager.sh up "$INTERFACE"
    ;;
  down)
    exec /app/wireguard-manager.sh down "$INTERFACE"
    ;;
  strip)
    if [[ -x /usr/bin/wg-quick.orig ]]; then
      exec /usr/bin/wg-quick.orig strip "$INTERFACE"
    else
      # 内置配置剥离实现
      sed -E '/^[[:space:]]*(Address|DNS|MTU|Table|PreUp|PostUp|PreDown|PostDown)[[:space:]]*=/d' "/etc/wireguard/${INTERFACE}.conf"
    fi
    ;;
  *)
    if [[ -x /usr/bin/wg-quick.orig ]]; then
      exec /usr/bin/wg-quick.orig "$@"
    else
      echo "wg-quick (wireguard-go wrapper): 未知参数 $*" >&2
      exit 1
    fi
    ;;
esac
